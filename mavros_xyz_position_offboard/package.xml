<?xml version="1.0"?>
<package format="3">
  <name>mavros_xyz_position_offboard</name>
  <version>0.1.0</version>
  <description>Safety-gated ROS 2 MAVROS native XYZ position monitor and controller.</description>
  <maintainer email="px4@example.invalid">PX4 test tools</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>
  <depend>lslidar_msgs</depend>
  <depend>jsoncpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
